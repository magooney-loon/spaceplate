{
	"name": "spaceplate",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"packageManager": "pnpm@11.5.2",
	"scripts": {
		"dev": "vite",
		"build": "vite build",
		"preview": "vite preview",
		"generate": "cargo run -p gen-bindings -- --out-dir src/module_bindings --module-path spacetimedb && prettier --write src/module_bindings",
		"spacetime:generate": "spacetime generate --lang typescript --out-dir src/module_bindings --module-path spacetimedb",
		"spacetime:publish:local": "spacetime publish --module-path spacetimedb --server local",
		"spacetime:publish:local:fresh": "spacetime publish --module-path spacetimedb --server local --delete-data --yes",
		"spacetime:publish": "spacetime publish --module-path spacetimedb --server maincloud"
	},
	"dependencies": {
		"@dimforge/rapier3d-compat": "^0.20.0",
		"@tailwindcss/vite": "^4.3.3",
		"@threlte/core": "^8.6.0",
		"@threlte/extras": "^9.21.1",
		"@threlte/rapier": "^3.5.0",
		"@threlte/studio": "^0.4.3",
		"@types/three": "^0.185.4",
		"spacetimedb": "^2.8.3",
		"svelte-tweakpane-ui": "^1.5.20",
		"tailwindcss": "^4.3.3",
		"three": "^0.185.1"
	},
	"devDependencies": {
		"@sveltejs/vite-plugin-svelte": "^7.3.0",
		"@types/node": "^26.4.0",
		"prettier": "^3.9.6",
		"prettier-plugin-svelte": "^4.1.1",
		"rollup-plugin-visualizer": "^7.1.1",
		"svelte": "^5.56.10",
		"svelte-check": "^4.7.6",
		"typescript": "~6.0.3",
		"vite": "^8.2.2"
	}
}
