+  // PATCH (spaceplate): TSL port of the original outline shader.
+  // Samples the 8 neighbours of each texel in the selected-objects render target and
+  // marks a pixel as "edge" whenever a neighbour's colour differs by more than
+  // edgeFactor -- identical maths to the GLSL it replaces, expressed as nodes.
+  const outlineColor = uniform(new Color('#FFFF00'))
+  const lineWidth = uniform(1.5)
+  const edgeFactor = uniform(0.0001)
+
+  const outlineMaterial = new NodeMaterial()
+  outlineMaterial.transparent = true
+  outlineMaterial.depthWrite = false
+  outlineMaterial.depthTest = false
+
+  {
+    const vUv = uv()
+    // Screen-space derivatives give a line width that stays constant in pixels.
+    const sampleStep = vec2(dFdx(vUv.x), dFdy(vUv.y)).mul(lineWidth)
+    const currentColor = texture(renderTarget.texture, vUv)
+
+    const neighbourOffsets = [
+      [-1, 1], // top-left
+      [0, 1], // top
+      [1, 1], // top-right
+      [1, 0], // right
+      [1, -1], // bottom-right
+      [0, -1], // bottom
+      [-1, -1], // bottom-left
+      [-1, 0] // left
+    ] as const
+
+    let edgeDetectValue = float(0)
+
+    for (const [offsetX, offsetY] of neighbourOffsets) {
+      const neighbour = texture(
+        renderTarget.texture,
+        vUv.add(vec2(sampleStep.x.mul(offsetX), sampleStep.y.mul(offsetY)))
+      )
+      edgeDetectValue = edgeDetectValue.add(
+        step(edgeFactor, length(currentColor.rgb.sub(neighbour.rgb)))
+      )
+    }
+
