@@ -0,0 +1,260 @@
+// PATCH (spaceplate): WebGPU compat.
+//
+// TSL port of gridShaders.js. The original is a raw ShaderMaterial; three's
+// NodeLibrary has no ShaderMaterial mapping, so on WebGPURenderer it is silently
+// replaced with a blank NodeMaterial ("Material \"ShaderMaterial\" is not
+// compatible") and the grid never draws.
+//
+// Credits to Evan Wallace https://madebyevan.com/shaders/grid/ for the original.
+//
+// Structural options (plane, type, axis, infiniteGrid, followCamera, maxRadius,
+// dividers, whether a background is drawn) are baked into the graph in JS rather
+// than branched on in the shader. They are plain props that change rarely, and it
+// avoids dynamic component indexing -- which GLSL allowed via position[coord0] but
+// WGSL will not do against a uniform index.
+import { NodeMaterial } from 'three/webgpu';
+import {
+	Discard,
+	Fn,
+	abs,
+	atan,
+	clamp,
+	float,
+	fract,
+	fwidth,
+	length,
+	max,
+	min,
+	mix,
+	modelWorldMatrixInverse,
+	pow,
+	positionLocal,
+	positionWorld,
+	select,
+	smoothstep,
+	varying,
+	vec2,
+	vec3,
+	vec4
+} from 'three/tsl';
+
+const PI = 3.141592653589793;
+const COMPONENTS = ['x', 'y', 'z'];
+
+const AXIS_TO_INT = { x: 0, y: 1, z: 2 };
+
+const PLANE_CONFIG = {
+	xz: { axes: 'xzy', normal: [0, 1, 0] },
+	xy: { axes: 'xyz', normal: [0, 0, 1] },
+	zy: { axes: 'zyx', normal: [1, 0, 0] }
+};
+
+export const planeConfig = PLANE_CONFIG;
+export const axisToInt = AXIS_TO_INT;
+
+/** Reorders a vec3's components, mirroring `vec3(v[c0], v[c1], v[c2])` in GLSL. */
+const swizzle = (node, [c0, c1, c2]) =>
+	vec3(node[COMPONENTS[c0]], node[COMPONENTS[c1]], node[COMPONENTS[c2]]);
+
+const coordsForPlane = (plane) => {
+	const { axes } = PLANE_CONFIG[plane] ?? PLANE_CONFIG.xz;
+	return [AXIS_TO_INT[axes.charAt(0)], AXIS_TO_INT[axes.charAt(1)], AXIS_TO_INT[axes.charAt(2)]];
+};
+
+/**
+ * Builds the grid NodeMaterial.
+ *
+ * @param u        TSL uniform nodes, shared with the component's reactive plumbing
+ * @param options  Structural options baked into the graph
+ */
+export const createGridMaterial = (u, options) => {
+	const {
+		plane = 'xz',
+		type = 'grid',
+		axis = 'x',
+		infiniteGrid = false,
+		followCamera = false,
+		maxRadius = 0,
+		cellDividers = 6,
+		sectionDividers = 2,
+		hasBackground = false,
+		side
+	} = options;
+
+	const coords = coordsForPlane(plane);
+	const lineComponent = COMPONENTS[AXIS_TO_INT[axis] ?? 0];
+
+	const material = new NodeMaterial();
+	material.transparent = true;
+	material.side = side;
+
+	// --- vertex ------------------------------------------------------------
+	// Mirrors the original vertex shader. Assigning positionNode lets the default
+	// model-view-projection path run, and keeps positionWorld consistent with the
+	// remapped position (the fragment stage needs it for distance fade).
+	const localPosition = Fn(() => {
+		const local = swizzle(positionLocal, coords).toVar();
+
+		if (infiniteGrid) {
+			local.mulAssign(float(1).add(u.fadeDistance));
+		}
+
+		if (followCamera) {
+			// The original offsets in world space then maps back through
+			// inverse(modelMatrix). Transforming the offset as a direction (w = 0)
+			// is the equivalent, done once instead of per-vertex round-tripping.
+			const worldOffset = u.worldCamProjPosition.sub(u.worldPlanePosition);
+			local.addAssign(modelWorldMatrixInverse.mul(vec4(worldOffset, 0)).xyz);
+		}
+
+		return local;
+	})();
+
+	material.positionNode = localPosition;
+
+	// The fragment stage re-applies the same swizzle to the (already swizzled)
+	// local position, exactly as the original shader does.
+	const vLocalPosition = varying(localPosition, 'vGridLocalPosition');
+
+	// --- grid patterns -----------------------------------------------------
+	const getSquareGrid = (size, thickness, localPos) => {
+		const coord = localPos.xy.div(size);
+		const grid = abs(fract(coord.sub(0.5)).sub(0.5)).div(fwidth(coord));
+		const line = min(grid.x, grid.y).add(1).sub(thickness);
+		return float(1).sub(min(line, 1));
+	};
+
+	const getLinesGrid = (size, thickness, localPos) => {
+		const coord = localPos[lineComponent].div(size);
+		const line = abs(fract(coord.sub(0.5)).sub(0.5))
+			.div(fwidth(coord))
+			.sub(thickness.mul(0.2));
+		return float(1).sub(min(line, 1));
+	};
+
+	// Both masks collapse to a constant when the grid is infinite or unbounded,
+	// which is the common case and keeps those branches out of the shader.
+	const bounded = !infiniteGrid && maxRadius > 0;
+
+	const getRadiusMask = (radius) => {
+		if (!bounded) return float(1);
+		const width = max(fwidth(radius), 0.0001);
+		return float(1).sub(smoothstep(u.circleGridMaxRadius, u.circleGridMaxRadius.add(width), radius));
+	};
+
+	const getPolarDividerMask = (radius) => {
+		if (!bounded) return float(1);
+		const width = max(fwidth(radius), 0.0001);
+		return float(1).sub(smoothstep(u.circleGridMaxRadius.sub(width), u.circleGridMaxRadius, radius));
+	};
+
+	const getCirclesGrid = (size, thickness, radius) => {
+		const coord = radius.div(size);
+		const line = abs(fract(coord.sub(0.5)).sub(0.5))
+			.div(fwidth(coord))
+			.sub(thickness.mul(0.2));
+		return float(1).sub(min(line, 1));
+	};
+
+	const getPolarGrid = (size, thickness, dividers, dividerCount, localPos, radius) => {
+		if (dividerCount <= 0) return getCirclesGrid(size, thickness, radius);
+
+		const rad = radius.div(size);
+		const angle = atan(localPos.x, localPos.y).mul(dividers).div(PI);
+		const coord = vec2(rad, angle);
+
+		const span = dividers.mul(2);
+		const wrapped = vec2(coord.x, fract(coord.y.div(span)).mul(span));
+
+		const coordWidth = fwidth(coord);
+		const wrappedWidth = fwidth(wrapped);
+		const half = dividers.mul(0.5);
+		const useWrapped = coord.y.lessThan(half.negate()).or(coord.y.greaterThan(half));
+		const width = select(useWrapped, wrappedWidth, coordWidth).mul(
+			float(1).add(thickness.mul(0.25))
+		);
+
+		const grid = abs(fract(coord.sub(0.5)).sub(0.5)).div(width);
+		const circle = float(1).sub(min(grid.x, 1));
+		const divider = float(1).sub(min(grid.y, 1));
+
+		return max(circle, divider.mul(getPolarDividerMask(radius)));
+	};
+
+	// --- fragment ----------------------------------------------------------
+	const result = Fn(() => {
+		const localPos = swizzle(vLocalPosition, coords);
+
+		let g1 = float(0);
+		let g2 = float(0);
+		let radiusMask = float(1);
+
+		if (type === 'lines') {
+			g1 = getLinesGrid(u.cellSize, u.cellThickness, localPos);
+			g2 = getLinesGrid(u.sectionSize, u.sectionThickness, localPos);
+		} else if (type === 'circular') {
+			const radius = length(localPos.xy);
+			g1 = getCirclesGrid(u.cellSize, u.cellThickness, radius);
+			g2 = getCirclesGrid(u.sectionSize, u.sectionThickness, radius);
+			radiusMask = getRadiusMask(radius);
+		} else if (type === 'polar') {
+			const radius = length(localPos.xy);
+			g1 = getPolarGrid(
+				u.cellSize,
+				u.cellThickness,
+				u.polarCellDividers,
+				cellDividers,
+				localPos,
+				radius
+			);
+			g2 = getPolarGrid(
+				u.sectionSize,
+				u.sectionThickness,
+				u.polarSectionDividers,
+				sectionDividers,
+				localPos,
+				radius
+			);
+			radiusMask = getRadiusMask(radius);
+		} else {
+			g1 = getSquareGrid(u.cellSize, u.cellThickness, localPos);
+			g2 = getSquareGrid(u.sectionSize, u.sectionThickness, localPos);
+		}
+
+		const dist = length(u.fadeOrigin.sub(positionWorld));
+		const d = float(1).sub(min(dist.div(u.fadeDistance), 1));
+		const fadeFactor = pow(d, u.fadeStrength).mul(0.95);
+
+		const color = mix(u.cellColor, u.sectionColor, min(u.sectionThickness.mul(g2), 1));
+
+		let rgb;
+		let alpha;
+
+		if (hasBackground) {
+			const linesAlpha = clamp(g1.add(g2).mul(fadeFactor), 0, 1);
+			rgb = mix(u.backgroundColor, color, linesAlpha);
+			alpha = max(linesAlpha, u.backgroundOpacity.mul(fadeFactor));
+		} else {
+			const baseAlpha = g1.add(g2).mul(pow(d, u.fadeStrength));
+			rgb = color;
+			// Sections stay at full strength while cells are damped to 75%.
+			alpha = mix(baseAlpha.mul(0.75), baseAlpha, g2);
+		}
+
+		const finalAlpha = alpha.mul(radiusMask).toVar();
+
+		// Matches the original's `discard`. Without it an infinite grid would write
+		// depth across the whole plane even where nothing is drawn.
+		Discard(finalAlpha.lessThanEqual(0));
+
+		return vec4(rgb, finalAlpha);
+	})();
+
+	// colorNode/opacityNode rather than fragmentNode: the original ended with
+	// <tonemapping_fragment> and <colorspace_fragment>, so output processing must
+	// still run.
+	material.colorNode = result.xyz;
+	material.opacityNode = result.w;
+
+	return material;
+};
