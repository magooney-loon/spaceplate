+	const getRadiusMask = (radius) => {
+		if (!bounded) return float(1);
+		const width = max(fwidth(radius), 0.0001);
+		return float(1).sub(smoothstep(u.circleGridMaxRadius, u.circleGridMaxRadius.add(width), radius));
+	};
