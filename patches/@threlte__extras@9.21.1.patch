+
+	// The fragment stage re-applies the same swizzle to the (already swizzled)
+	// local position, exactly as the original shader does.
+	const vLocalPosition = varying(localPosition, 'vGridLocalPosition');
+
+	// --- grid patterns -----------------------------------------------------
+	const getSquareGrid = (size, thickness, localPos) => {
+		const coord = localPos.xy.div(size);
+		const grid = abs(fract(coord.sub(0.5)).sub(0.5)).div(fwidth(coord));
+		const line = min(grid.x, grid.y).add(1).sub(thickness);
+		return float(1).sub(min(line, 1));
+	};
+
+	const getLinesGrid = (size, thickness, localPos) => {
+		const coord = localPos[lineComponent].div(size);
+		const line = abs(fract(coord.sub(0.5)).sub(0.5))
+			.div(fwidth(coord))
+			.sub(thickness.mul(0.2));
+		return float(1).sub(min(line, 1));
+	};
+
+	// Both masks collapse to a constant when the grid is infinite or unbounded,
+	// which is the common case and keeps those branches out of the shader.
+	const bounded = !infiniteGrid && maxRadius > 0;
